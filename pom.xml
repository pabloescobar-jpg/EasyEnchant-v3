<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Coordinates -->
  <groupId>com.meatylumberjack</groupId>
  <artifactId>easy-enchantments</artifactId>
  <version>1.0.1</version>
  <name>EasyEnchantments</name>
  <description>Easy item give/enchant, glow, rename &amp; color commands with Essentials-style messages.</description>
  <url>https://github.com/pabloescobar-jpg/easy-enchant-nbt</url>

  <!-- Publisher / metadata -->
  <developers>
    <developer>
      <id>Meatylumberjack</id>
      <name>Meatylumberjack</name>
      <organization>EasyEnchantments</organization>
      <organizationUrl>https://github.com/pabloescobar-jpg</organizationUrl>
    </developer>
  </developers>
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <paper.version>1.21.4-R0.1-SNAPSHOT</paper.version>
    <!-- EXACT jar filename -->
    <project.build.finalName>EasyEnchantments1.0.1</project.build.finalName>
  </properties>

  <repositories>
    <repository>
      <id>papermc-repo</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Paper API (provided at runtime by the server) -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.build.finalName}</finalName>

    <plugins>
      <!-- Java 17 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <!-- Create PACKACGE_INSIDE.zip with the built jar inside -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>zip-distribution</id>
            <phase>package</phase>
            <configuration>
              <target name="zip-jar">
                <delete file="${project.build.directory}/PACKACGE_INSIDE.zip"/>
                <zip destfile="${project.build.directory}/PACKACGE_INSIDE.zip">
                  <zipfileset dir="${project.build.directory}" includes="${project.build.finalName}.jar"/>
                </zip>
              </target>
            </configuration>
            <goals><goal>run</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- If you later need to bundle libs, uncomment shade and keep the same finalName
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <finalName>${project.build.finalName}</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
            </configuration>
          </execution>
        </executions>
      </plugin>
      -->
    </plugins>
  </build>
</project>

